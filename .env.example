# ==============================================================================
# JBØ6 MINI ERP - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit your actual .env file or share your service role key.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION STRINGS (Prisma on Supabase / Vercel Serverless)
# ------------------------------------------------------------------------------
# DATABASE_URL: Uses Supabase Connection Pooler (Supavisor) on port 6543 (Transaction mode).
# Must end with "?pgbouncer=true&connection_limit=1" for serverless functions.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Uses Supabase Session Pooler on port 5432.
# Used strictly for Prisma migrations and schema pushes (avoids IPv6-only issues).
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS
# ------------------------------------------------------------------------------
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# SERVER-ONLY PRIVILEGED KEY (Never prefix with NEXT_PUBLIC_, never share):
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAYS (Sandbox / Test Mode)
# Leave blank to automatically use the built-in Local Mock Payment Provider!
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_WEBHOOK_ID=""

PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 4. CRON & INTERNAL SECURITY
# ------------------------------------------------------------------------------
CRON_SECRET="jb06_super_secret_cron_token_replace_me"

# ------------------------------------------------------------------------------
# 5. APP URLS (Local Development Defaults)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_CONSOLE_URL="http://localhost:3001"

